    { "type": "board-ssd1306", "id": "oled", "top": -140, "left": 150, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 120, "left": 250, "attrs": {} }
